{
  "app": "ammonia_dispatch_copilot",
  "delivery_status": "acceptance_demo",
  "status_legend": {
    "online_verified": ["bitable", "verification_task"],
    "prototype": ["interactive_card", "approval", "event_callback"],
    "platform_enablement_required": ["aily", "native_task_ai_agent"]
  },
  "fact_contract": [
    "source_system",
    "source_timestamp",
    "ingested_at",
    "unit",
    "quality_code",
    "market_confirmed_by",
    "market_version",
    "owner",
    "lineage_id"
  ],
  "recommendation_contract": [
    "recommendation_id",
    "input_snapshot_hash",
    "rule_version",
    "model_version",
    "valid_until",
    "approval_path",
    "rollback_condition",
    "payload_hash",
    "idempotency_key"
  ],
  "feishu_objects": {
    "interactive_card": {
      "target": "合成氨当班调度群",
      "actions": ["accept_and_approve", "request_review", "reject_with_reason"],
      "idempotency_key": ["shift_id", "proposal_id", "action_id"]
    },
    "approval": {
      "definition_code": "ammonia_load_adjustment",
      "low_risk_path": ["班长确认"],
      "hard_trigger_path": ["班长确认", "设备专业或调度主管会签"]
    },
    "bitable": {
      "table_name": "合成氨调度复盘库",
      "required_fields": [
        "shift_id",
        "proposal_id",
        "scenario",
        "target_load_percent",
        "evidence_completeness",
        "baseline_plan_contribution_cny_24h",
        "recommended_allocation_contribution_cny_24h",
        "attributable_benefit_cny",
        "approval_path",
        "accepted",
        "reject_reason",
        "action_order_version",
        "synthesis_ack_status",
        "nitric_ack_status",
        "tank_dispatch_ack_status",
        "utility_ack_status",
        "all_actions_acknowledged_at",
        "actual_load_percent",
        "actual_margin_percent",
        "operator_note"
      ],
      "knowledge_governance_fields": ["root_cause", "applicable_operating_window", "professional_review", "rule_stage", "replay_result", "withdrawn_rule_version"]
    },
    "task": {
      "title": "跟踪负荷调整执行效果",
      "checklist": ["责任岗位逐项接令", "确认DCS historian实际负荷", "记录未采纳原因", "班后复盘收益归因"],
      "verification_task": "https://applink.feishu.cn/client/todo/detail?guid=44631b59-b834-47b1-a413-b751f2f291da&suite_entity_num=t136777",
      "production_task_status": "create_only_after_approved_instance"
    },
    "event_callback": {
      "events": ["card.action.trigger", "approval.instance.status_changed", "bitable.record.changed"],
      "guards": ["signature_verification", "replay_protection", "idempotent_write", "manual_downgrade_when_evidence_incomplete"],
      "failure_handling": ["bounded_retry", "dead_letter_queue", "manual_reconcile", "immutable_audit_log"]
    },
    "feishu_ai": {
      "entry": "合成氨调度问答助手",
      "sources": ["产供销全线事实表", "MES订单", "DCS摘要", "设备趋势", "调度复盘库", "处置规则"],
      "answer_contract": ["先给结论", "列出当前数值", "说明安全边界", "标注事实来源", "给出责任人与复核时间"],
      "actions": ["generate_shift_card", "create_execution_task", "draft_review_record"],
      "guards": ["no_source_no_answer", "human_approval_for_high_risk", "never_write_dcs_or_sis"]
    },
    "evidence_package": {
      "schema": "data/evidence_package_schema.json",
      "export_action": "导出当前方案证据包",
      "write_targets_after_approval": ["Feishu Base review record", "MES plan summary"],
      "required_contents": ["input_snapshot", "decision_gates", "material_balance", "action_sheet", "ack_state", "source_lineage"],
      "boundary": "Local export is an audit handover artifact; it does not mean execution and never writes DCS or SIS.",
      "actual_value_rule": "Actual load, inventory, energy and benefit can only be filled by Historian or an approved enterprise fact source."
    }
  },
  "operator_cockpit": {
    "market_price_gate": {
      "reference_sources": ["nbs_production_materials", "czce_market_data", "mofcom_commodity_price"],
      "execution_source": "yuntu_erp_business_price",
      "required_confirmation": ["product", "region", "price", "unit", "tax_included", "freight_basis", "effective_at", "confirmed_by", "version"],
      "unconfirmed_action": "keep_last_valid_version_and_freeze_new_economic_ranking",
      "feishu_record": ["source_id", "source_url", "published_at", "fetched_at", "business_effective_at", "quality_code", "confirmed_by", "version"],
      "boundary": "reference_cards_only; no_dcs_or_sis_write"
    },
    "event_priorities": ["P1", "P2", "P3"],
    "allocation_decisions": ["保", "稳", "降", "限", "停", "询价外采"],
    "execution_checks": ["班长确认", "跨装置动作单", "责任岗位接令", "MES目标负荷", "现场执行反馈", "班末效果复核"],
    "action_receipt_rule": "岗位接令只证明已看到并复核动作；全部接令后方可进入执行跟踪，实际执行仍以Historian或MES回传为准",
    "feasibility_gate": "24小时物料平衡低于安全库存或高于罐区上限时标记无可执行方案，禁止审批和动作派发",
    "stale_data_threshold_minutes": 15,
    "execution_feedback_rule": "historian_not_connected_means_pending_never_synthetic_actual"
  },
  "pilot_scope_30_days": {
    "inputs": ["MES订单与班次记录离线导出", "ERP行情与成本日表", "Historian五至十五分钟摘要", "设备趋势导出"],
    "writeback": ["MES班次计划摘要", "飞书交接摘要", "飞书复盘记录"],
    "excluded": ["DCS控制参数", "SIS参数", "自动开停车", "未授权跨系统写入"]
  },
  "knowledge_governance": {
    "states": ["raw_shift_fact", "pending_case_review", "confirmed_case", "candidate_rule", "historical_replay", "professional_cosign", "production_rule", "disabled_or_withdrawn"],
    "promotion_guard": "单班成功不得自动改变生产规则；生产、工艺或设备、安环按场景完成专业会签后方可晋级",
    "withdrawal_guard": "连续偏差、适用工况越界、数据漂移或专业否决时停用规则并保留版本和原因"
  },
  "acceptance_90_days": {
    "minimum_valid_shifts": 30,
    "required_scenarios": ["产供销重排", "公辅波动吸收", "设备趋势复核"],
    "gates": ["安全硬约束零突破", "建议可复算率100%", "未接Historian时实际值为空", "收益仅在同口径原计划对照后归因"],
    "metric_definition_draft": {
      "source_data_availability": ">=98% within declared pilot windows",
      "mass_balance_residual": "<=1.5% per valid shift after inventory calibration",
      "recommendation_recompute_p95": "<=120 seconds for read-only pilot snapshots",
      "decision_time_reduction": ">=30% median versus registered manual baseline",
      "high_priority_order_fulfillment": "not lower than matched manual baseline",
      "load_reversal_count": "not higher than matched manual baseline",
      "known_event_replay": "report detection lead time, false positives and misses separately; no composite score"
    }
  }
}
